# Zonnehoeve Chatbot - Example Environment Variables
# Copy this file to .env and replace the placeholder values.

# ==========================================
# BACKEND SETTINGS
# ==========================================

# Database Connection (e.g. Postgres DB from Railway or Local Docker)
# When using pgvector extension, connection string must be configured.
DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/zonnehoeve"

# API Keys — never commit a real .env file
OPENAI_API_KEY="your-openai-api-key-here"
ADMIN_API_KEY="your-secure-admin-password-here"

# LLM Configuration
LLM_MODEL="gpt-4o-mini"
EMBEDDING_MODEL="text-embedding-3-small"
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1000
LLM_MAX_RETRIES=1

# Retrieval & RAG settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVER_K=4
USE_RERANKER="false"

# Server Settings
ENVIRONMENT="development"  # set to "production" in prod
CORS_ORIGINS="http://localhost:3000"

# Local Storage Paths
RAW_DATA_PATH="data/raw_documents"

# ==========================================
# FRONTEND SETTINGS
# ==========================================
# In development, these URLs point to local backend.
# In production on Railway, let the CI/CD pipeline or Railway settings override these.
BACKEND_URL="http://127.0.0.1:8000"
NEXT_PUBLIC_API_URL="http://localhost:8000"
